{
  "format_version": "1.21.90",
  "minecraft:block": {
    "description": {
      "identifier": "secretfacilities:blast_door",
      "menu_category": {
        "category": "construction"
      },
      "states": {
        "secretfacilities:open": [
          false,
          true
        ],
        "secretfacilities:slide": [
          0,
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ]
      }
    },
    "components": {
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 4
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 1200
      },
      "minecraft:geometry": "minecraft:geometry.full_block",
      "minecraft:material_instances": {
        "*": {
          "texture": "blast_door",
          "render_method": "opaque"
        }
      },
      "minecraft:map_color": "#44555e"
    },
    "permutations": [
      {
        "condition": "q.block_state('secretfacilities:slide') > 0",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "door_open",
              "render_method": "alpha_test"
            }
          },
          "minecraft:light_dampening": 0
        }
      },
      {
        "condition": "q.block_state('secretfacilities:open')",
        "components": {
          "minecraft:collision_box": false,
          "minecraft:selection_box": false,
          "minecraft:geometry": "minecraft:geometry.full_block",
          "minecraft:material_instances": {
            "*": {
              "texture": "door_open",
              "render_method": "alpha_test"
            }
          },
          "minecraft:light_dampening": 0
        }
      }
    ]
  }
}
