{
  "compilerOptions": {
    "target": "ES2020", "module": "ES2020", "moduleResolution": "bundler",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "skipLibCheck": false, "rootDir": "src", "outDir": "behavior_pack/scripts",
    "lib": ["ES2020"], "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
