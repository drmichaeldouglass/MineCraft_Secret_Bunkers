{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "secretfacilities:blast_door_leaf",
      "materials": {
        "default": "entity"
      },
      "textures": {
        "default": "textures/blocks/blast_door"
      },
      "geometry": {
        "default": "geometry.secretfacilities.blast_door_leaf"
      },
      "animations": {
        "slide": "animation.secretfacilities.door_leaf.slide"
      },
      "scripts": {
        "initialize": [
          "v.shown = -1;"
        ],
        "pre_animation": [
          "t.target = q.property('secretfacilities:progress');",
          "v.shown = (v.shown < 0 || math.abs(t.target - v.shown) > 0.25) ? t.target : v.shown + math.clamp(t.target - v.shown, -0.8 * q.delta_time, 0.8 * q.delta_time);"
        ],
        "animate": [
          "slide"
        ]
      },
      "render_controllers": [
        "controller.render.secretfacilities.door_leaf"
      ]
    }
  }
}
